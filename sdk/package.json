{
  "name": "@clanker/gate-client",
  "version": "0.1.0",
  "description": "TypeScript SDK for ClankerGate - policy-based transaction validator for ERC-4337 Smart Accounts",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "erc-4337",
    "account-abstraction",
    "smart-account",
    "policy",
    "gate",
    "blockchain",
    "ethereum"
  ],
  "license": "MIT",
  "dependencies": {
    "merkletreejs": "^0.4.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
